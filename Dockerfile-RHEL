FROM rockylinux:9.3

# Set URLs for the packages
ENV X86_64_URL=https://dl.rockylinux.org/pub/rocky/9/CRB/x86_64/os/Packages/n/ninja-build-1.10.2-6.el9.x86_64.rpm
ENV AARCH64_URL=https://dl.rockylinux.org/pub/rocky/9/CRB/aarch64/os/Packages/n/ninja-build-1.10.2-6.el9.aarch64.rpm

# Conditional download and installation
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        curl -OL $X86_64_URL && \
        dnf install -y ./ninja-build-1.10.2-6.el9.x86_64.rpm && \
        rm -f ./ninja-build-1.10.2-6.el9.x86_64.rpm; \
    elif [ "$ARCH" = "aarch64" ]; then \
        curl -OL $AARCH64_URL && \
        dnf install -y ./ninja-build-1.10.2-6.el9.aarch64.rpm && \
        rm -f ./ninja-build-1.10.2-6.el9.aarch64.rpm; \
    else \
        echo "Unsupported architecture: $ARCH" && exit 1; \
    fi

RUN dnf makecache
# Install my shell
RUN dnf install -y zsh tmux git gcc-c++ which

# Install requirements for nvim build
WORKDIR /tmp

RUN dnf install -y cmake gcc make unzip gettext glibc-gconv-extra

RUN git clone --branch release-0.11 --single-branch https://github.com/neovim/neovim.git

WORKDIR /tmp/neovim
RUN make CMAKE_BUILD_TYPE=Release
RUN make install

RUN curl -sS https://starship.rs/install.sh | sh -s -- --yes

# Install Goss for testing
RUN curl -fsSL https://goss.rocks/install | sh

# Create my user
RUN useradd -ms /usr/bin/zsh me
# Set workdir to my home directory
USER me
WORKDIR /home/me

# Install rust so that we can use rust tools
ENV PATH="/home/me/.cargo/bin:${PATH}"
RUN curl https://sh.rustup.rs -sSf | bash -s -- -y
RUN echo 'source ~/.cargo/env' >> /home/me/.bashrc

# cargo-binstall pulls each tool's prebuilt release binary rather than
# compiling it. Compiling is disabled as a fallback so a missing binary fails
# the build instead of quietly adding minutes to it. musl builds come first:
# they are static, whereas the gnu builds can need a newer glibc than EL9's.
RUN curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash
RUN ARCH=$(uname -m) && cargo binstall -y --disable-strategies compile \
    --targets "$ARCH-unknown-linux-musl" --targets "$ARCH-unknown-linux-gnu" \
    eza ripgrep atuin

# `docker run` does not set USER the way a login does, and the goss suite
# keys its user check on it.
ENV USER=me

